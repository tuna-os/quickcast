<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app-id@</id>
  <name>Quickcast</name>
  <summary>Record your screen and webcam, then paste the video</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="org.tunaos"><name>TunaOS contributors</name></developer>
  <description>
    <p>Quickcast records a screen, window or region with microphone and optional desktop audio. Add a webcam in any corner, then automatically copy the finished video as a file attachment.</p>
    <p>Recordings are saved locally as compact H.264/AAC MP4 files. Quickcast is based on Kooha and integrates with the GNOME desktop.</p>
  </description>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <url type="homepage">https://github.com/tuna-os/quickcast</url>
  <url type="bugtracker">https://github.com/tuna-os/quickcast/issues</url>
  <provides><binary>kooha</binary></provides>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <caption>Quick recording with microphone and webcam controls</caption>
      <image>https://raw.githubusercontent.com/tuna-os/quickcast/main/data/screenshots/quickcast.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.0" date="2026-09-15">
      <description><p>Initial release with webcam overlay, compact MP4 recording and automatic file copying.</p></description>
    </release>
  </releases>
</component>
